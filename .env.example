# The Centurion - Environment Variables Configuration

# Base URL for metadata and canonical links
NEXT_PUBLIC_SITE_URL=https://thecenturionlucknow.com

# Demo mode: When true, search engines will be instructed not to index the site (noindex)
DEMO_MODE=true

# Official WhatsApp Contact for Reservation routing (International format without spaces)
NEXT_PUBLIC_WHATSAPP=+919119603535

# Optional: Resend API Key for automatic email notifications on table reservations
RESEND_API_KEY=

# Optional: Destination email address for reservation alerts
RESERVATION_TO_EMAIL=
